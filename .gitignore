.DS_Store

## Fish variables that should never be pushed
fish_variables
*.local.fish
secrets.fish
private.fish

## fish plugin-generated files (regenerated by `fisher update`)
# Everything in functions/ except my hand-written fzf-pick-command
fish/functions/*
!fish/functions/fzf-pick-command.fish
# Everything in completions/ except my hand-added tailscale completion
fish/completions/*
!fish/completions/tailscale.fish
# Plugin-shipped conf.d init scripts (keep hand-written uv.env.fish and .gitnow)
fish/conf.d/_tide_init.fish
fish/conf.d/fzf.fish
fish/conf.d/gitnow.fish
fish/conf.d/z.fish
